# Loki values (Ansible 관리, roles/monitoring)
# 실습 규모라 single binary + 파일시스템 저장소로 띄운다
deploymentMode: SingleBinary

loki:
  auth_enabled: false           # 테넌트 하나(fake)만 쓴다
  commonConfig:
    replication_factor: 1
  storage:
    type: filesystem
  schemaConfig:
    configs:
      - from: "2024-01-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index:
          prefix: loki_index_
          period: 24h
  # 로그 알림 규칙: 앱 쪽에서 monitoring namespace 에 loki-alert-rules ConfigMap 을 만들면 /rules/fake 로 마운트된다
  rulerConfig:
    alertmanager_url: http://kube-prometheus-stack-alertmanager.{{ monitoring_namespace }}.svc:9093
    enable_api: true
    enable_alertmanager_v2: true
    storage:
      type: local
      local:
        directory: /rules
    rule_path: /var/loki/rules-temp
    ring:
      kvstore:
        store: inmemory

singleBinary:
  replicas: 1
  nodeSelector:
    workload: monitoring
  persistence:
    enabled: true
    storageClass: local-path
    size: {{ loki_storage_size }}
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 1Gi
  extraVolumes:
    - name: alert-rules
      configMap:
        name: loki-alert-rules
        optional: true
  extraVolumeMounts:
    - name: alert-rules
      mountPath: /rules/fake

# single binary 에서 쓰지 않는 구성 요소는 끈다
backend:
  replicas: 0
read:
  replicas: 0
write:
  replicas: 0
gateway:
  enabled: false
chunksCache:
  enabled: false
resultsCache:
  enabled: false
lokiCanary:
  enabled: false
test:
  enabled: false
minio:
  enabled: false
